# Copie este arquivo para .env e ajuste se o seu MySQL não for o padrão do XAMPP.
# O .env fica fora do controle de versão: é nele que ficam o usuário e a senha do banco.
DB_HOST=127.0.0.1
DB_PORTA=3306
DB_USUARIO=root
DB_SENHA=
DB_NOME=gemovel

# Chave que assina o cookie de login. Gere uma com:
#   backend/.venv/Scripts/python -c "import secrets; print(secrets.token_hex(32))"
# Sem ela, o Flask usa uma chave temporária, e todo mundo sai quando ele reinicia.
SEGREDO_SESSAO=
